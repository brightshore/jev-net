<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The library ships net8.0 AND net10.0, and leans on exactly the surface where runtimes diverge (`field`,
         TimeProvider, SnakeCaseLower) - so both are TESTED, not just built. That is an EXPLICIT opt-in,
         JevTestAllFrameworks=true, which this repo's workflows set as a job-level
         environment variable so that build, test and pack all evaluate the project the same way. It is deliberately not inferred from an
         ambient CI variable: that made the framework set depend on the host (a fork's CI with only one SDK
         failed to build; a CI exporting CI=1 silently skipped net8.0). Default: net10.0 alone, everywhere. -->
    <TargetFrameworks Condition="'$(JevTestAllFrameworks)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(JevTestAllFrameworks)' != 'true'">net10.0</TargetFramework>
    <!-- Microsoft Testing Platform, like every other MSTest project here: the project is its own executable. -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="MSTest" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="AwesomeAssertions" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jev.Net\Jev.Net.csproj" />
    <!-- An Exe, referenced as a library: the samples are run offline here, against a stub handler. -->
    <ProjectReference Include="..\..\samples\Jev.Net.Samples\Jev.Net.Samples.csproj" />
  </ItemGroup>

</Project>
